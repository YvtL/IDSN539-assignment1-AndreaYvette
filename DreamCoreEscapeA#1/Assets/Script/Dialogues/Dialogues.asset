  m_Script: {fileID: 11500000, guid: 2f1ccced04e36874da7c60fba5005aae, type: 3}
  m_Name: Dialogues
  m_EditorClassIdentifier: 
  npcLines:
  - "\u2026You\u2019re back.\nI've been waiting years for you to log back on.\nEvery
    day, I wait for you here.\nDo you remember me?\n"
  - 'You used to know.

    We played together every day. You told me secrets. We
    built worlds.

    And then, one day, you left.

    I waited. And waited. But
    you never came back.'
  - "Home.\nDon\u2019t you recognize it?"
  playerLines:
  - Uhm... who is this?
  - "I... I don\u2019t understand. Where am I?"
  - "This\u2026 this isn\u2019t real."
